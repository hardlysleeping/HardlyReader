# Environment for the billing service (`server/billing`).
#
# Copy to `.env` (gitignored) and fill in. EVERY value below is a secret except PORT, HOST and
# APP_URL: this process holds the Stripe secret key and the Supabase service_role key, which
# bypasses row-level security. None of these may ever appear in the app's bundle, in
# `.env.example` at the repo root, in a commit, or in a chat message.
#
#   set -a; . ./.env; set +a; node main.mjs

# ── Stripe ────────────────────────────────────────────────────────────────────
# sk_test_… while testing. The two price ids come from the HardlySyncing product;
# leaving one empty means that plan is simply not offered.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Only for the suite, which points the client at a stub on localhost. Leave unset.
# STRIPE_API_BASE=http://127.0.0.1:9000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL, the service_role key (server-only), and the anon key (used to ask
# /auth/v1/user which reader a JWT belongs to).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ── The app ───────────────────────────────────────────────────────────────────
# Where Checkout returns to, and which browser origins may call this service.
# APP_ORIGINS empty means no browser is allowed — correct for a desktop-only build.
APP_URL=https://bazzite-1.tail900410.ts.net:8457
APP_ORIGINS=https://bazzite-1.tail900410.ts.net:8457,http://localhost:4179

PORT=8787
HOST=127.0.0.1
