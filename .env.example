# Environment for the web/app build.
#
# Copy to `.env` (gitignored) and fill in. Both values below are PUBLIC: the anon key ships in
# every web bundle by design, and row-level security in supabase/schema.sql is what protects data.
#
# NEVER put the service_role key here. It bypasses RLS, so anything in this file ends up in a
# bundle and in the repository's history. The service key belongs to the payment webhook only.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Where the PWA is served from, for absolute links (optional).
# PUBLIC_APP_ORIGIN=https://bazzite-1.tail900410.ts.net:8457
