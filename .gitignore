key.properties
src-tauri/gen/android/keystore.properties

# Android/Gradle output: app/build alone is 1.9 GB and every file carries an
# absolute path from the machine that built it.
# Generated by `tauri android init`; BuildTask.kt embeds the absolute path of the
# machine that ran it, and the build regenerates it.
# The Keystore class is committed at android/SecureStore.kt; the copy inside the
# generated project is a build product, made by scripts/android-build.sh.
src-tauri/gen/android/app/src/main/java/ing/hardlysleep/hardlyreader/SecureStore.kt
src-tauri/gen/android/buildSrc/
src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/.kotlin/
src-tauri/gen/android/local.properties
*.apk
*.aab
# Loose files at the root that are not part of the app.
photo.png
card-preview.html
indent-preview.html
pane-model-preview.html
preview-*.png

# Test scratch the suites regenerate.
.gen-*/

# working notes: private, never published
BACKLOG.md
# the demo's fetched feeds and pictures (scripts/demo-feeds.mjs writes them at build time)
public/demo/
dist-ipa

# Flatpak build output: the repo, the stage and the bundles are regenerated by
# scripts/build-all.sh and published to ~/Flatpaks. Tracked until 0.6.43, which
# made every clone and every CI run pay for ~20 MB per build (0 tracked files
# at 638 MB). The files stay on disk; git only stops carrying them.
/flatpak
