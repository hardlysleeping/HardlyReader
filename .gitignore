key.properties
src-tauri/gen/android/keystore.properties

# Android/Gradle output: app/build alone is 1.9 GB and every file carries an
# absolute path from the machine that built it.
# Generated by `tauri android init`; BuildTask.kt embeds the absolute path of the
# machine that ran it, and the build regenerates it.
src-tauri/gen/android/buildSrc/
src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/.kotlin/
src-tauri/gen/android/local.properties
*.apk
*.aab
# Loose files at the root that are not part of the app.
photo.png
card-preview.html
indent-preview.html
pane-model-preview.html
preview-*.png

# Test scratch the suites regenerate.
.gen-*/

# working notes: private, never published
BACKLOG.md
